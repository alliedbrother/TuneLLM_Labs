# TuneLLM Environment Variables
# Copy this file to .env and update the values

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_USER=tunellm
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=tunellm

# ===========================================
# Security
# ===========================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_generate_with_openssl

# JWT Token settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Backend API
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# Storage paths (inside container)
STORAGE_PATH=/data/storage
MODELS_PATH=/data/models

# ===========================================
# Agent Configuration
# ===========================================
NODE_NAME=my-gpu-node
AGENT_API_KEY=

# ===========================================
# Production Settings
# ===========================================
# Your domain name
DOMAIN=tunellm.yourdomain.com

# Email for Let's Encrypt certificates
ACME_EMAIL=admin@yourdomain.com

# Container image version
VERSION=latest

# ===========================================
# Optional: Weights & Biases
# ===========================================
WANDB_API_KEY=
WANDB_PROJECT=tunellm

# ===========================================
# Optional: HuggingFace
# ===========================================
HF_TOKEN=
HF_HOME=/data/huggingface

# ===========================================
# Optional: Cloud Storage (S3-compatible)
# ===========================================
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tunellm-storage
