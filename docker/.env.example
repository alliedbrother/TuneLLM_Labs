# TuneLLM Docker Environment
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Database
POSTGRES_USER=tunellm
POSTGRES_PASSWORD=tunellm_dev
POSTGRES_DB=tunellm

# Security — CHANGE THIS in production!
# Generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production

# Cloud GPU (optional — can also set via UI)
# Get from: https://cloud.vast.ai/cli/
VASTAI_API_KEY=

# AI Providers for PDF Q&A (optional — can also set via UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# HuggingFace token for gated models like Llama (optional)
HF_TOKEN=
